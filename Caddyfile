# ตอนนี้ยังไม่มีโดเมน เลยรันเป็น plain HTTP บน :80 ไปก่อน
# พอมีโดเมนจริงแล้ว แก้แค่บรรทัดนี้จาก ":80" เป็นชื่อโดเมน เช่น "guard.example.com"
# Caddy จะขอ HTTPS certificate ให้อัตโนมัติทันที ไม่ต้องแก้อย่างอื่นเพิ่ม
:80 {
	encode zstd gzip

	# Caddy ใส่ X-Forwarded-For / X-Forwarded-Proto ให้อัตโนมัติอยู่แล้ว
	# ตรงกับ TRUST_PROXY_HEADERS=true, TRUSTED_PROXY_HOPS=1 ใน .env ของ backend
	reverse_proxy backend:8000
}
